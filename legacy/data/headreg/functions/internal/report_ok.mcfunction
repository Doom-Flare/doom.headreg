# headreg:internal/report_ok —— 注册成功后的 tellraw 回报
# 前置：headreg:tmp cur 已写回；#now 已算好；@s 为玩家
# 后置：#sm/#ss/#tm/#ts2 已由 session_stats 写好；只读不写记录
tellraw @s [{"text":"[headreg] ","color":"dark_gray"},{"text":"注册完成","color":"green"}]
execute if data storage headreg:tmp cur.name run tellraw @s [{"text":"  名称: ","color":"gray"},{"nbt":"cur.name","storage":"headreg:tmp","color":"white"},{"text":"  数字id: ","color":"gray"},{"score":{"name":"@s","objective":"headreg.id"},"color":"white"}]
execute unless data storage headreg:tmp cur.name run tellraw @s [{"text":"  名称: ","color":"gray"},{"text":"（档案里没有 Name，略）","color":"dark_gray"},{"text":"  数字id: ","color":"gray"},{"score":{"name":"@s","objective":"headreg.id"},"color":"white"}]
execute if data storage headreg:tmp cur{premium:1b} run tellraw @s [{"text":"  正版: ","color":"gray"},{"text":"是（档案含 textures 签名）","color":"green"}]
execute unless data storage headreg:tmp cur{premium:1b} run tellraw @s [{"text":"  正版: ","color":"gray"},{"text":"否（离线档案，profile 内没有 properties）","color":"red"}]
tellraw @s [{"text":"  档案时刻(秒): ","color":"gray"},{"nbt":"cur.ts_sec","storage":"headreg:tmp","color":"aqua"}]

# 首次登记时刻：first_sec 现算成日期再渲染（§4：不存 date_str）
scoreboard players set #t headreg.calc 0
execute if data storage headreg:tmp cur.first_sec store result score #t headreg.calc run data get storage headreg:tmp cur.first_sec
execute if data storage headreg:tmp cur.first_sec run function headreg:internal/format_time
execute if data storage headreg:tmp cur.first_sec run tellraw @s [{"text":"  首次登记(UTC): ","color":"gray"},{"score":{"name":"#ya","objective":"headreg.calc"},"color":"yellow"},{"score":{"name":"#yb","objective":"headreg.calc"},"color":"yellow"},{"score":{"name":"#yc","objective":"headreg.calc"},"color":"yellow"},{"score":{"name":"#yd","objective":"headreg.calc"},"color":"yellow"},{"text":"-","color":"yellow"},{"score":{"name":"#moh","objective":"headreg.calc"},"color":"yellow"},{"score":{"name":"#mol","objective":"headreg.calc"},"color":"yellow"},{"text":"-","color":"yellow"},{"score":{"name":"#dh","objective":"headreg.calc"},"color":"yellow"},{"score":{"name":"#dl","objective":"headreg.calc"},"color":"yellow"},{"text":" ","color":"yellow"},{"score":{"name":"#hh","objective":"headreg.calc"},"color":"yellow"},{"score":{"name":"#hl","objective":"headreg.calc"},"color":"yellow"},{"text":":","color":"yellow"},{"score":{"name":"#mih","objective":"headreg.calc"},"color":"yellow"},{"score":{"name":"#mil","objective":"headreg.calc"},"color":"yellow"},{"text":":","color":"yellow"},{"score":{"name":"#sh","objective":"headreg.calc"},"color":"yellow"},{"score":{"name":"#sl","objective":"headreg.calc"},"color":"yellow"}]
function headreg:internal/format_now
tellraw @s [{"text":"  现在(UTC): ","color":"gray"},{"score":{"name":"#ya","objective":"headreg.calc"},"color":"aqua"},{"score":{"name":"#yb","objective":"headreg.calc"},"color":"aqua"},{"score":{"name":"#yc","objective":"headreg.calc"},"color":"aqua"},{"score":{"name":"#yd","objective":"headreg.calc"},"color":"aqua"},{"text":"-","color":"aqua"},{"score":{"name":"#moh","objective":"headreg.calc"},"color":"aqua"},{"score":{"name":"#mol","objective":"headreg.calc"},"color":"aqua"},{"text":"-","color":"aqua"},{"score":{"name":"#dh","objective":"headreg.calc"},"color":"aqua"},{"score":{"name":"#dl","objective":"headreg.calc"},"color":"aqua"},{"text":" ","color":"aqua"},{"score":{"name":"#hh","objective":"headreg.calc"},"color":"aqua"},{"score":{"name":"#hl","objective":"headreg.calc"},"color":"aqua"},{"text":":","color":"aqua"},{"score":{"name":"#mih","objective":"headreg.calc"},"color":"aqua"},{"score":{"name":"#mil","objective":"headreg.calc"},"color":"aqua"},{"text":":","color":"aqua"},{"score":{"name":"#sh","objective":"headreg.calc"},"color":"aqua"},{"score":{"name":"#sl","objective":"headreg.calc"},"color":"aqua"}]
function headreg:internal/format_leave
tellraw @s [{"text":"  上次结算(UTC): ","color":"gray"},{"score":{"name":"#ya","objective":"headreg.calc"},"color":"yellow"},{"score":{"name":"#yb","objective":"headreg.calc"},"color":"yellow"},{"score":{"name":"#yc","objective":"headreg.calc"},"color":"yellow"},{"score":{"name":"#yd","objective":"headreg.calc"},"color":"yellow"},{"text":"-","color":"yellow"},{"score":{"name":"#moh","objective":"headreg.calc"},"color":"yellow"},{"score":{"name":"#mol","objective":"headreg.calc"},"color":"yellow"},{"text":"-","color":"yellow"},{"score":{"name":"#dh","objective":"headreg.calc"},"color":"yellow"},{"score":{"name":"#dl","objective":"headreg.calc"},"color":"yellow"},{"text":" ","color":"yellow"},{"score":{"name":"#hh","objective":"headreg.calc"},"color":"yellow"},{"score":{"name":"#hl","objective":"headreg.calc"},"color":"yellow"},{"text":":","color":"yellow"},{"score":{"name":"#mih","objective":"headreg.calc"},"color":"yellow"},{"score":{"name":"#mil","objective":"headreg.calc"},"color":"yellow"},{"text":":","color":"yellow"},{"score":{"name":"#sh","objective":"headreg.calc"},"color":"yellow"},{"score":{"name":"#sl","objective":"headreg.calc"},"color":"yellow"}]

function headreg:internal/session_stats
tellraw @s [{"text":"  本次在线: ","color":"gray"},{"score":{"name":"#sm","objective":"headreg.calc"},"color":"green"},{"text":" 分 ","color":"gray"},{"score":{"name":"#ss","objective":"headreg.calc"},"color":"green"},{"text":" 秒   累计在线: ","color":"gray"},{"score":{"name":"#tm","objective":"headreg.calc"},"color":"green"},{"text":" 分 ","color":"gray"},{"score":{"name":"#ts2","objective":"headreg.calc"},"color":"green"},{"text":" 秒","color":"gray"}]
execute unless data storage headreg:tmp cur{settled:1b} run tellraw @s [{"text":"  上段: ","color":"gray"},{"text":"首次登记（没有可结算的上一段）","color":"dark_gray"}]
execute if data storage headreg:tmp cur{settled:1b,exit_kind:"global"} run tellraw @s [{"text":"  上次结束: ","color":"gray"},{"text":"与至少一人同一时刻消失（同一事件：关服 / 全服掉线）","color":"yellow"}]
execute if data storage headreg:tmp cur{settled:1b,exit_kind:"personal"} run tellraw @s [{"text":"  上次结束: ","color":"gray"},{"text":"单独离开（同服另有记录，均不在该时刻）","color":"aqua"}]
execute if data storage headreg:tmp cur{settled:1b,exit_kind:"solo"} run tellraw @s [{"text":"  上次结束: ","color":"gray"},{"text":"单独离开（无可比较的同伴，无法判全局/个人）","color":"dark_aqua"}]
execute if data storage headreg:tmp cur{settled:1b} if data storage headreg:tmp cur.prev_play run tellraw @s [{"text":"  上段在线(tick): ","color":"gray"},{"nbt":"cur.prev_play","storage":"headreg:tmp","color":"white"}]
tellraw @s [{"text":"  登记次数: ","color":"gray"},{"nbt":"cur.reg_count","storage":"headreg:tmp","color":"white"}]
tellraw @s [{"text":"  查询他人: /trigger headreg.qlist 看名单，/trigger headreg.query set <编号> 看某人","color":"dark_gray"},{"text":"  提示: 「档案时刻」是服务端从会话服务器取到该档案的时刻，不代表登录时刻。","color":"dark_gray"}]
